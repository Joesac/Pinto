{
  "name": "pinto",
  "version": "1.0.0",
  "description": "Create Pints and PVs",
  "main": "main.js",
  "dependencies": {
    "knex": "^0.19.4",
    "sqlite3": "^4.1.0"
  },
  "devDependencies": {
    "electron": "^6.0.8",
    "electron-builder": "^21.2.0",
    "electron-rebuild": "^1.8.6"
  },
  "scripts": {
    "electron": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "electron-builder install-app-deps",
    "electron:win": "electron-builder build -w zip",
    "rebuild": "electron-rebuild --version 1.8.6 --module-dir ./node_modules/sqlite3"
  },
  "build": {
    "appId": "com.plainblue.pinto",
    "productName": "Pinto",
    "directories": {
      "buildResources": "./assets"
    },
    "extraFiles": "db.sqlite",
    "extraResources": ["./assets/company-logo.jpg", "./assets/title-bar-icon.png", "./assets/Splashscreen.svg"]
  },
  "keywords": [],
  "author": "Plainblue Company",
  "license": "ISC"
}
